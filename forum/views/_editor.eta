<div class="editor" data-editor>
  <div class="editor-bar" role="toolbar" aria-label="Formatting" hidden>
    <button type="button" data-md="bold" title="Bold"><b>B</b></button>
    <button type="button" data-md="italic" title="Italic"><i>I</i></button>
    <button type="button" data-md="link" title="Link">Link</button>
    <button type="button" data-md="quote" title="Quote">Quote</button>
    <button type="button" data-md="list" title="List">List</button>
    <button type="button" data-md="code" title="Inline code">Code</button>
    <label class="visually-hidden" for="code-lang">Code block language</label>
    <select id="code-lang" data-lang>
<% for (const l of ['cpp', 'c', 'ini', 'json', 'bash', 'powershell', 'python', 'lua', 'diff', 'plaintext']) { %>      <option value="<%= l %>"><%= l %></option>
<% } %>    </select>
    <button type="button" data-md="block" title="Code block">Code block</button>
<% if (it.canUpload) { %>    <label class="upload-btn">Image<input type="file" accept="image/png,image/jpeg,image/webp" data-upload class="visually-hidden"></label>
<% } %>
    <span class="spacer"></span>
    <button type="button" data-tab="write" aria-pressed="true">Write</button>
    <button type="button" data-tab="preview" aria-pressed="false">Preview</button>
  </div>
  <label for="body">Post</label>
  <textarea id="body" name="body" rows="12" maxlength="20000" required<% if (it.error && it.error.field === 'body') { %> aria-invalid="true" aria-describedby="body-error"<% } %>><%= it.body || '' %></textarea>
  <%~ include('/_field_error', { name: 'body', error: it.error }) %>
  <div class="preview body" data-preview hidden aria-live="polite"></div>
  <p class="meta" data-upload-status aria-live="polite"></p>
  <p class="meta">Markdown: **bold**, *italic*, `code`, ```cpp for code blocks, @nickname to mention.</p>
</div>
