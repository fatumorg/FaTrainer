#include <winver.h>
#include "version_values.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,0,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VER_FILETYPE
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "FaTrainer"
      VALUE "FileDescription", VER_DESCRIPTION
      VALUE "FileVersion", VER_STRING
      VALUE "InternalName", VER_INTERNAL
      VALUE "LegalCopyright", "MIT License, github.com/fatumorg/DyingLightFaTrainer"
      VALUE "OriginalFilename", VER_FILENAME
      VALUE "ProductName", "FaTrainer"
      VALUE "ProductVersion", VER_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
